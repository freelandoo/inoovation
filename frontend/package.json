{
  "name": "innovation-week-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "assets:label": "python scripts/build_label_assets.py",
    "check": "npm run typecheck && npm run lint && npm test && vite build"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
