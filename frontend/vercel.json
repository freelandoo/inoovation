{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/membro/:token",
      "destination": "/membro.html"
    },
    {
      "source": "/membro",
      "destination": "/membro.html"
    },
    {
      "source": "/telao",
      "destination": "/telao.html"
    },
    {
      "source": "/admin/apresentacao",
      "destination": "/apresentacao.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/((?!assets/|models/|innovation-week/|ar/|membro|telao|privacidade|admin).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(models|innovation-week|ar)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
