# Na Railway: use a referência ao banco do projeto -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Só se conectar pela URL pública do Postgres com SSL (na rede interna da Railway não precisa)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Domínios do frontend liberados no CORS, separados por vírgula (vazio = qualquer origem)
ALLOWED_ORIGINS=https://SEU-PROJETO.vercel.app

# Token (mín. 16 caracteres) para GET /api/stats. Sem ele, a rota fica desativada.
ADMIN_TOKEN=

# Login da área admin (/admin) e da apresentação. A senha vai como hash:
#   npm run admin:hash -- 'sua senha'
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Aplica as migrações ao iniciar (padrão true)
AUTO_MIGRATE=true

# A Railway define PORT automaticamente
# PORT=3000
