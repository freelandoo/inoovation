{
  "name": "innovation-week-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "registry:import": "node --env-file-if-exists=.env src/registry.ts",
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0"
  }
}
